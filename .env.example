# PostgreSQL connection strings (e.g. from Neon).
# DATABASE_URL: pooled connection used by the app.
# DIRECT_URL: direct (non-pooled) connection used for migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# First administrator: logging in with these creates the admin account (only while none exists).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-to-something-long"

# Paystack secret key (sk_test_... or sk_live_...). Leave empty to hide online payment.
PAYSTACK_SECRET_KEY=""
