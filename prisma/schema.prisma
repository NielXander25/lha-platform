// Learning Hub Africa data model.
// SQLite for local development; switch `provider` to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A tutorial offering students can pay for, e.g. "SSS Mathematics".
model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  category    String       // e.g. Mathematics, Sciences, Languages, Exam Prep
  level       String       // e.g. Primary, Junior Secondary, Senior Secondary, University
  summary     String
  description String
  price       Int          // whole currency units (NGN)
  billingUnit String       @default("month") // price is charged per this unit
  sessionsPerWeek Int      @default(2)
  sessionLengthMins Int    @default(60)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
}

model Tutor {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  phone       String?
  subjects    String       // comma-separated list of subjects
  bio         String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
}

// Where a tutorial takes place: a learning centre, a home-tutoring area, or online.
model Location {
  id          String       @id @default(cuid())
  name        String
  city        String
  address     String?
  isOnline    Boolean      @default(false)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
}

model Student {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  phone       String
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
}

// A student's request for a course. Staff assign a tutor and a location to it.
model Enrollment {
  id                  String    @id @default(cuid())
  studentId           String
  courseId            String
  tutorId             String?
  locationId          String?
  preferredLocationId String?   // what the student asked for when signing up
  status              String    @default("PENDING") // PENDING | ASSIGNED | ACTIVE | COMPLETED | CANCELLED
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  tutor    Tutor?    @relation(fields: [tutorId], references: [id], onDelete: SetNull)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([status])
}
