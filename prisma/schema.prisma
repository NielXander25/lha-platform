// Learning Hub Africa data model.
// SQLite for local development; switch `provider` to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A university course tutorial students can pay for, e.g. "MTH 101 – Elementary Mathematics I".
model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  code        String?      // course code, e.g. "MTH 101"
  title       String
  category    String       // faculty, e.g. Sciences, Engineering, Management Sciences
  level       String       // e.g. 100 Level, 200 Level
  summary     String
  description String
  price       Int          // whole currency units (NGN)
  billingUnit String       @default("semester") // price is charged per this unit
  sessionsPerWeek Int      @default(2)
  sessionLengthMins Int    @default(60)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
}

model Tutor {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  phone       String?
  subjects    String       // comma-separated list of subjects
  bio         String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  assignments Assignment[]
}

// Where a tutorial takes place: a study centre near a campus, or online.
model Location {
  id          String       @id @default(cuid())
  name        String
  city        String
  address     String?
  isOnline    Boolean      @default(false)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  assignments Assignment[]
}

// A tutor teaching a course at a location. Visitors see these on the course page.
model Assignment {
  id         String   @id @default(cuid())
  courseId   String
  tutorId    String
  locationId String
  schedule   String?  // free text, e.g. "Tue & Thu, 4:00 pm"
  createdAt  DateTime @default(now())

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tutor    Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([courseId, tutorId, locationId])
}
