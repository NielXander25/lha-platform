// Learning Hub Africa data model: tutorials for Air Force Institute of Technology (AFIT) students.
// PostgreSQL (Neon in production). DATABASE_URL is the pooled connection used by the
// app; DIRECT_URL is a direct connection used for migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A university course tutorial students can pay for, e.g. "MTH 101 – Elementary Mathematics I".
model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  code        String?      // course code, e.g. "MTH 101"
  title       String
  category    String       // subject, e.g. Mathematics, Physics, Chemistry
  level       String       // "100 Level" to "500 Level"
  departments Department[] // departments whose students take this course
  summary     String
  description String
  sessionsPerWeek Int      @default(2)
  sessionLengthMins Int    @default(60)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments Assignment[]
}

// An engineering department, e.g. "Mechatronics Engineering".
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  courses   Course[]
}

// A pricing option that applies to every course, e.g. "One-on-one" at 10,000.
model PricingTier {
  id          String   @id @default(cuid())
  name        String
  ratio       String   // short label, e.g. "1 student : 1 tutor"
  description String
  price       Int      // whole Naira
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Tutor {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  phone       String?
  subjects    String       // comma-separated list of subjects
  bio         String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  assignments Assignment[]
}

// Where a tutorial holds on campus, e.g. "LR 101" or "Hall C1".
model Location {
  id          String       @id @default(cuid())
  name        String       @unique
  kind        String       @default("Lecture room") // e.g. Lecture room, Hall
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  assignments Assignment[]
}

// A tutor teaching a course at a location. Visitors see these on the course page.
model Assignment {
  id         String   @id @default(cuid())
  courseId   String
  tutorId    String
  locationId String
  schedule   String?  // free text, e.g. "Tue & Thu, 4:00 pm"
  createdAt  DateTime @default(now())

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tutor    Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([courseId, tutorId, locationId])
}
